APP_NAME="Innova Fulfillment"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=innova
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=database

# Shopify
SHOPIFY_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# Amazon SP-API
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_SP_REGION=us-east-1

# DB schema overrides — fill in after receiving client schema dump
DB_TABLE_ORDER=Order
DB_TABLE_ORDER_LINE_ITEM=OrderLineItem
DB_TABLE_ORDER_SHIPPING=OrderShipping
DB_COL_ADMIN_ORDER_STATUS=AdminOrderStatus
DB_COL_REQUIRES_SHIPPING=RequiresShipping
DB_COL_TRACKING_NUMBER=TrackingNumber
DB_COL_UPDATE_DATE=UpdateDate

# Scheduler
FULFILLMENT_ENGINE_INTERVAL_MINUTES=15
NIGHTLY_SYNC_TIME=17:30
